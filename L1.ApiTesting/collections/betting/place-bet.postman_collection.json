		{
			"name": "Test with all valid inputs as specified in API information",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var now = new Date();\r",
							"var formattedDate = now.toISOString();  // Example: \"2025-03-21T14:30:00.000Z\"\r",
							"pm.environment.set(\"current_date\", formattedDate);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();\r",
							"pm.test(\"Response status is 200\", function()\r",
							"{\r",
							"  pm.expect(pm.response.to.have.status(200));\r",
							"\r",
							"})\r",
							"pm.test(\"Response body contains expected fields\", function()\r",
							"{\r",
							"    pm.expect(jsonData.result).to.have.property(\"obTransId\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"playerId\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"balance\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"minBet\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"maxBet\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"seq\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorCode\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorMessage\");    \r",
							"    pm.expect(jsonData.result).to.have.property(\"errorDescription\");    \r",
							"})\r",
							"\r",
							"pm.test(\"Balance update correctly after place bet\", function()\r",
							"{\r",
							"    var beforeBalance = pm.environment.get(\"balance\");\r",
							"    var betAmount = pm.environment.get(\"betamount\");\r",
							"    pm.expect(jsonData.result.balance).eql(beforeBalance-betAmount);\r",
							"    pm.environment.set(\"balance\",jsonData.result.balance);\r",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
