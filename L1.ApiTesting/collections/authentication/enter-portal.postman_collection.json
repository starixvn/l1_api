	"item": [
		{
			"name": "Test with all valid inputs",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();\r",
							"pm.test(\"Status code is 200\", function()\r",
							"{\r",
							"    pm.response.to.have.status(200);\r",
							"\r",
							"});\r",
							"pm.test(\"Response correctly fields\", function()\r",
							"{\r",
							"    pm.expect(jsonData.result).to.have.property(\"minBet\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"maxBet\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"seq\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorCode\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorMessage\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorDescription\");\r",
							"    \r",
							"\r",
							"})\r",
							"pm.test(\"Min bet is correct\", function()\r",
							"{\r",
							"\r",
							"    pm.expect(jsonData.result.minBet).eql(1);\r",
							"})\r",
							"\r",
							"pm.test(\"Max bet is correct\", function()\r",
							"{\r",
							"\r",
							"    pm.expect(jsonData.result.maxBet).eql(3000);\r",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"operatorId\": \"{{operatorId}}\",\r\n\"playerId\": \"{{playerId}}\",\r\n\"siteId\": \"{{siteId}}\",\r\n\"characterName\": \"{{characterName}}\",\r\n\"seq\": \"string\",\r\n\"firstLogin\": false,\r\n\"operatorToken\": \"string\"\r\n}",
