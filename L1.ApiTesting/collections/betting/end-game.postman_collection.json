	"item": [
		{
			"name": "Test with all valid inputs",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var now = new Date();\r",
							"var formattedDate = now.toISOString();  // Example: \"2025-03-21T14:30:00.000Z\"\r",
							"pm.environment.set(\"current_date\", formattedDate);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();\r",
							"pm.test(\"Response status is 200\", function()\r",
							"{\r",
							"  pm.expect(pm.response.to.have.status(200));\r",
							"\r",
							"})\r",
							"pm.test(\"Reponse correct fields\", function()\r",
							"{\r",
							"    pm.expect(jsonData.result).to.have.property(\"playerId\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"seq\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorCode\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorMessage\");\r",
							"    pm.expect(jsonData.result).to.have.property(\"errorDescription\");\r",
							"\r",
							"})\r",
							"pm.test(\"Response correct value\", function()\r",
							"{\r",
							"    var expectPlayerId = pm.environment.get(\"playerId\");\r",
							"    pm.expect(jsonData.result.playerId).eql(expectPlayerId);\r",
							"    pm.expect(jsonData.result.errorCode).eql(0);\r",
							"    pm.expect(jsonData.result.errorMessage).eql(null);\r",
							"    pm.expect(jsonData.result.errorDescription).eql(null);\r",
							"\r",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
